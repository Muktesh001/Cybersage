# ================================================
# CyberSage Backend - Environment Variables
# ================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ================================================

# ---- Server Configuration ----
PORT=5000
NODE_ENV=development

# ---- Frontend URL (for CORS) ----
FRONTEND_URL=http://localhost:5173

# ---- MongoDB Connection ----
# Local:   mongodb://localhost:27017/cybersage
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/cybersage
MONGO_URI=mongodb://localhost:27017/cybersage

# ---- JWT Configuration ----
# Use a long, random, secret string (minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_in_production
JWT_REFRESH_EXPIRES_IN=30d

# ---- Password Reset ----
# Token expiry in milliseconds (1 hour = 3600000)
RESET_TOKEN_EXPIRES=3600000

# ---- Gemini AI API ----
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ---- Email Configuration (for Password Reset) ----
# Using Gmail SMTP as example
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=CyberSage <your_email@gmail.com>

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ---- Scanner Configuration ----
# Maximum time in ms to wait for a target URL response
SCANNER_TIMEOUT=10000
# Maximum redirects to follow
SCANNER_MAX_REDIRECTS=5

# ---- Admin Configuration ----
ADMIN_EMAIL=admin@cybersage.com
